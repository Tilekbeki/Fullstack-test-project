{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "db.ts", "models/**/*.ts", "controllers/**/*.ts", "routes/**/*.ts", "lib/**/*.ts"],
  "exclude": ["tests", "dist"]
}
