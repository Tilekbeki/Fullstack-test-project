{
  "name": "test-dashboard-server",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx --test tests/integration/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,ts,tsx,scss}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg-promise": "^11.10.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "body-parser": "^1.20.9"
  }
}
